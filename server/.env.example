PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=botmng
DB_PASSWORD=change-me
DB_NAME=botmng
BOT_OUT_LOG=/path/to/ScheduleAlertBot/data/out.log
BOT_ERROR_LOG=/path/to/ScheduleAlertBot/data/error.log
JWT_SECRET=change-me
# 계정 비밀번호: 계정마다 서로 다른 12자 이상 (짧거나 같으면 서버가 시작을 거부한다). 생성: openssl rand -base64 24
ADMIN_PASSWORD=change-me
GUEST_PASSWORD=change-me
# (선택) 외부 서비스(DevMng) 전용 계정. 비우면 서비스 계정을 만들지 않고 기존 것도 지운다. 화면 로그인은 막혀 있다
# DEVMNG_PASSWORD=change-me
# 외부 공개용 HTTPS (Cloudflare Origin 인증서). 둘 다 설정하면 0.0.0.0 으로 HTTPS 서빙, 비우면 127.0.0.1 HTTP
# (경로는 server/ 기준 상대 경로 가능)
# TLS_CERT_PATH=./certs/origin.pem
# TLS_KEY_PATH=./certs/origin.key
